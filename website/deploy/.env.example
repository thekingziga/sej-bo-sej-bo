ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-to-a-long-random-string
HOST_PORT=3000

# --- Donations - optional. Leave any of these blank and the matching API
# endpoints return 503 instead of failing to start. ---

# Stripe (web / Windows checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Apple in-app purchase verification (App Store Server API)
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
# Paste the .p8 private key contents; keep the \n line breaks literal.
APPLE_IAP_PRIVATE_KEY=
APPLE_BUNDLE_ID=fyi.sejbosejbo
APPLE_IAP_SANDBOX=false

# Google Play purchase verification (Play Developer API)
# The full service-account JSON key, as a single-line string.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PACKAGE_NAME=

# --- Universal / app links - optional. Leave blank and the .well-known
# files 404, so shared links just open the website instead of the app. ---
APPLE_TEAM_ID=
ANDROID_PACKAGE_NAME=com.thekingziga.sejbosejbo
# Comma-separated - both are public certificates, safe to commit/share.
# First is Play App Signing (what installs from Play carry); second is the
# upload key (what directly-installed test APKs carry). Only the first means
# sideloaded test builds can never verify App Links before you ship.
ANDROID_CERT_SHA256=55:B5:A8:A8:F3:17:5A:EE:C2:1A:46:F4:48:01:3C:8B:2C:94:E8:36:84:A4:BC:48:FC:2B:4D:DF:E5:20:71:29,F5:0E:41:67:4B:01:45:4C:5A:11:05:F0:7F:B4:D2:52:CE:09:23:62:49:11:19:90:8F:80:59:DA:98:99:16:C9

# --- Report notification email - optional. Leave any of these blank and
# reports still work, just without an email alert; who gets notified is
# set separately in /admin/settings, not here. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if left blank.
SMTP_FROM=

# --- AI copy via Ollama - optional. Leave OLLAMA_HOST blank and the site
# uses its built-in phrase lists, exactly as before. ---
# Reachable from inside the container: use the host IP or an ollama service
# name, NOT 127.0.0.1 (that is the container itself).
# Which backend to use: "ollama" (local daemon) or "openai" (any
# OpenAI-compatible hosted API - NanoGPT, OpenRouter, OpenAI...).
AI_PROVIDER=ollama

# --- if AI_PROVIDER=ollama ---
# Must be reachable from inside the container: the host's LAN IP, NOT
# 127.0.0.1 (that is the container itself).
OLLAMA_HOST=
OLLAMA_MODEL=llama3.2:1b

# --- if AI_PROVIDER=openai ---
# Base URL WITHOUT /chat/completions - that gets appended.
#   NanoGPT:    https://nano-gpt.com/api/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   OpenAI:     https://api.openai.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Applies to both. Generous because nothing waits on generation.
OLLAMA_TIMEOUT_MS=180000

# --- Audio/video uploads - OFF by default. Images and GIFs only unless
# this is "true". Video is far heavier than images and this runs off an
# SD card, so it is deliberately opt-in. ---
ENABLE_MEDIA_UPLOADS=false

# --- File storage --------------------------------------------------------
# "local" (default) keeps uploads on the bind-mounted ./uploads directory,
# exactly as the site has always worked. Set to "s3" to put NEW uploads in
# an S3-compatible bucket instead.
#
# Works with any S3-compatible server - your own MinIO/Ceph, Cloudflare R2,
# Backblaze B2, Hetzner, AWS - because it uses path-style URLs
# (S3_ENDPOINT/bucket/key) and plain SigV4. No AWS SDK is installed.
#
# If STORAGE_DRIVER=s3 but any of the four required vars below is missing,
# the app logs a clear error and falls back to local disk rather than
# refusing to start.
STORAGE_DRIVER=local

# Required when STORAGE_DRIVER=s3:
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional:
# Region must match what your server expects. MinIO commonly wants
# us-east-1; AWS wants the bucket's real region.
S3_REGION=us-east-1
# Keys are stored under this prefix, e.g. "uploads".
S3_PREFIX=
# Where browsers fetch objects from - a CDN or public bucket domain.
# Falls back to S3_ENDPOINT/S3_BUCKET, which only works if the bucket
# serves public reads.
S3_PUBLIC_BASE_URL=

# --- Database (required) -------------------------------------------------
# Postgres replaced the embedded SQLite database. There is no fallback:
# the container exits on startup if it cannot reach these.
#
# Migrating an existing SQLite install? Copy the data across first:
#   docker compose exec sejbosejbo node scripts/migrate-sqlite-to-postgres.js --dry-run
# then drop --dry-run. It never modifies the SQLite file, so data/ stays a
# valid rollback.
#
# The database should be UTF8 encoded - SQL_ASCII silently miscounts and
# mis-cases Slovenian characters. ICU with sl-SI also gets č/š/ž sorting
# right:
#   CREATE DATABASE sejbosejbo WITH OWNER = sejbosejbo TEMPLATE = template0
#     ENCODING = 'UTF8' LOCALE_PROVIDER = icu ICU_LOCALE = 'sl-SI'
#     LC_COLLATE = 'C' LC_CTYPE = 'C';
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
PGPOOL_MAX=10

# --- Timezone ------------------------------------------------------------
# What the *site* presents itself in: post timestamps on the page, and which
# calendar day the Sejbometer and daily award treat as "today".
#
# Timestamps are always STORED as UTC; this only changes how they are shown
# and where the day boundary falls. The JSON API's created_at stays ISO-8601
# UTC regardless - the app parses that, and shifting it would move every
# date the app displays.
SITE_TIMEZONE=Europe/Ljubljana

# --- Second S3 bucket: mirror ---------------------------------------------
# Every upload is written to this bucket as well as the primary, so losing
# one provider (or one accidental bucket deletion) does not lose the files.
#
# Best-effort on purpose: the PRIMARY write must succeed for an upload to be
# accepted, but a failing mirror only logs a warning. A second bucket exists
# to make the site more durable, not to give it a second thing that can
# reject a post. A missed object is healed by re-running:
#
#   docker compose exec sejbosejbo node scripts/migrate-uploads-to-s3.js --mirror
#
# Leave blank to disable mirroring. Setting only some of these logs an error
# and disables it rather than half-working.
S3_MIRROR_BUCKET=
S3_MIRROR_ENDPOINT=
S3_MIRROR_ACCESS_KEY_ID=
S3_MIRROR_SECRET_ACCESS_KEY=
S3_MIRROR_REGION=us-east-1
S3_MIRROR_PREFIX=

# --- Database backups -----------------------------------------------------
# scripts/backup-database.sh (run from cron on the host, not in the
# container) writes compressed pg_dumps here and prunes older ones.
BACKUP_DIR=/home/pidocker/sejbosejbo/db-backups
BACKUP_KEEP_DAYS=14
