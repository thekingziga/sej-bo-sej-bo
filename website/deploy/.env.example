ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-to-a-long-random-string
HOST_PORT=3000

# --- Donations - optional. Leave any of these blank and the matching API
# endpoints return 503 instead of failing to start. ---

# Stripe (web / Windows checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Apple in-app purchase verification (App Store Server API)
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
# Paste the .p8 private key contents; keep the \n line breaks literal.
APPLE_IAP_PRIVATE_KEY=
APPLE_BUNDLE_ID=fyi.sejbosejbo
APPLE_IAP_SANDBOX=false

# Google Play purchase verification (Play Developer API)
# The full service-account JSON key, as a single-line string.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PACKAGE_NAME=

# --- Universal / app links - optional. Leave blank and the .well-known
# files 404, so shared links just open the website instead of the app. ---
APPLE_TEAM_ID=
ANDROID_PACKAGE_NAME=com.thekingziga.sejbosejbo
# Comma-separated - both are public certificates, safe to commit/share.
# First is Play App Signing (what installs from Play carry); second is the
# upload key (what directly-installed test APKs carry). Only the first means
# sideloaded test builds can never verify App Links before you ship.
ANDROID_CERT_SHA256=55:B5:A8:A8:F3:17:5A:EE:C2:1A:46:F4:48:01:3C:8B:2C:94:E8:36:84:A4:BC:48:FC:2B:4D:DF:E5:20:71:29,F5:0E:41:67:4B:01:45:4C:5A:11:05:F0:7F:B4:D2:52:CE:09:23:62:49:11:19:90:8F:80:59:DA:98:99:16:C9

# --- Report notification email - optional. Leave any of these blank and
# reports still work, just without an email alert; who gets notified is
# set separately in /admin/settings, not here. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if left blank.
SMTP_FROM=
